# 复制为 .env 使用；密钥与口令不要提交到 Git
DJANGO_SECRET_KEY=please-generate-a-48-char-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

DB_ENGINE=mysql
DB_NAME=db_runner
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# 留空则使用本地内存缓存（单进程演示）；配置后使用 DatabaseCache，可跨进程互斥
CACHE_BACKEND=db
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
